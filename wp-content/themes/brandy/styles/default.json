{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Default styles",
  "description": "Default site",
  "settings": {
    "color": {
      "palette": [
        {
          "color": "#111111",
          "slug": "brandy-primary",
          "name": "Brandy Primary"
        },
        {
          "color": "#000000",
          "slug": "brandy-secondary",
          "name": "Brandy Secondary"
        }
      ]
    }
  },
  "styles": {
    "elements": {
      "button": {
        ":hover": {
          "color": {
            "background": "#2f2f2f"
          }
        }
      }
    },
    "blocks": {
      "core/post-featured-image": {
        "dimensions": {
          "aspectRatio": "5/3"
        }
      },
      "woocommerce/product-image": {
        "dimensions": {
          "aspectRatio": "1"
        }
      }
    }
  }
}
